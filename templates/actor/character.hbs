<form class="character-section" autocomplete="off">
  <header>
    <div class="header-container">
      <h3>{{actor.name}}</h3>
    </div>
    <div class="header-current-values">
      <img class="profile-img" src="{{img}}" alt="{{actor.name}}" title="{{localize "PnS2.Portrait_MouseOver"}}" draggable="false" />
      <!-- Current Values Section -->
      <div class="current-value-item">
        <label title="{{localize "PnS2.HP_MouseOver"}}">{{localize "PnS2.HP"}}</label>
        {{#if system.settings.showEpBar}}<label title="{{localize "PnS2.EP_MouseOver"}}">{{localize "PnS2.EP"}}</label>{{/if}}
        {{#if system.settings.showMpBar}}<label title="{{localize "PnS2.MP_MouseOver"}}">{{localize "PnS2.MP"}}</label>{{/if}}
        {{#if system.settings.showKpBar}}<label title="{{localize "PnS2.KP_MouseOver"}}">{{localize "PnS2.KP"}}</label>{{/if}}
        {{#if system.settings.showSpBar}}<label title="{{localize "PnS2.SP_MouseOver"}}">{{localize "PnS2.SP"}}</label>{{/if}}
      </div>
      <div class="current-value-item">
        <div class="custom-progress-bar hp-bar">
          <div class="progress-fill" style="width: {{#if system.hp.total}}{{multiply system.hp.currentValue 100 system.hp.total}}%{{else}}0%{{/if}}"></div>
          <input type="number" name="system.hp.currentValue" value="{{system.hp.currentValue}}" data-dtype="Number" /> 
          <span class="progress-text"> / {{system.hp.total}}</span>
        </div>
        {{#if system.settings.showEpBar}}
        <div class="custom-progress-bar ep-bar">
          <div class="progress-fill" style="width: {{#if system.ep.total}}{{multiply system.ep.currentValue 100 system.ep.total}}%{{else}}0%{{/if}}"></div>
          <input type="number" name="system.ep.currentValue" value="{{system.ep.currentValue}}" data-dtype="Number" />
          <span class="progress-text"> / {{system.ep.total}}</span>
        </div>
        {{/if}}
        {{#if system.settings.showMpBar}}
        <div class="custom-progress-bar mp-bar">
          <div class="progress-fill" style="width: {{#if system.mp.total}}{{multiply system.mp.currentValue 100 system.mp.total}}%{{else}}0%{{/if}}"></div>
          <input type="number" name="system.mp.currentValue" value="{{system.mp.currentValue}}" data-dtype="Number" />
          <span class="progress-text"> / {{system.mp.total}}</span>
        </div>
        {{/if}}
        {{#if system.settings.showKpBar}}
        <div class="custom-progress-bar kp-bar">
          <div class="progress-fill" style="width: {{#if system.kp.total}}{{multiply system.kp.currentValue 100 system.kp.total}}%{{else}}0%{{/if}}"></div>
          <input type="number" name="system.kp.currentValue" value="{{system.kp.currentValue}}" data-dtype="Number" />
          <span class="progress-text"> / {{system.kp.total}}</span>
        </div>
        {{/if}}
        {{#if system.settings.showSpBar}}
        <div class="custom-progress-bar sp-bar">
          <div class="progress-fill" style="width: {{#if system.sp.total}}{{multiply system.sp.currentValue 100 system.sp.total}}%{{else}}0%{{/if}}"></div>
          <input type="number" name="system.sp.currentValue" value="{{system.sp.currentValue}}" data-dtype="Number" />
          <span class="progress-text"> / {{system.sp.total}}</span>
        </div>
        {{/if}}
      </div>
    </div>
    <div class="header-buttons-container">
      <button type="button" class="toggle-edit-mode" title="{{localize 'PnS2.ToggleEditMode'}}">
        <i class="fas fa-lock-open"></i>
      </button>
      <button type="button" class="toggle-calc-visibility" title="{{localize 'PnS2.ToggleCalcVisibility'}}">
        <i class="fas fa-eye"></i>
      </button>
    </div>
  </header>
  <!-- Tab area -->
  <nav class="sheet-tabs tabs" data-group="primary">
  <a class="item active" data-action="tab" data-group="primary" data-tab="basiswerte">
    {{localize "PnS2.Basiswerte"}}
  </a>
  <a class="item" data-action="tab" data-group="primary" data-tab="talents">
    {{localize "PnS2.Talents"}}
  </a>
  <a class="item" data-action="tab" data-group="primary" data-tab="profil">
    {{localize "PnS2.Profil"}}
  </a>
</nav>
  <div class="sheet-body">
    <div class="tab active" data-group="primary" data-tab="basiswerte">
      <div class="character-stats">
        <!-- ######## Extra stats ######## -->
        <div class="character-basestats-row">
          <label title="{{localize "PnS2.EXP_MouseOver"}}">{{localize "PnS2.EXP"}}</label>
          <input type="number" name="system.exp.value" value="{{system.exp.value}}" />
          <span class="calc-span">{{system.exp.value}}</span>
        </div>
        <div class="character-basestats-row">
          <label class="rollable" data-roll="1d100" data-key="luck" title="{{localize "PnS2.LUCK_MouseOver"}}">{{localize "PnS2.LUCK"}}</label>
          <input type="number" name="system.luck.value" value="{{system.luck.value}}" />
          <span class="calc-span">{{system.luck.value}}</span>
        </div>
        <br/>
        <!-- ######## Headline ######## -->
        <div class="character-basestats-row">
          <div></div>
          <label>{{localize "PnS2.CharacterSheet.Base"}}</label>
          <label>{{localize "PnS2.CharacterSheet.Modifier"}}</label>
          <label>{{localize "PnS2.CharacterSheet.Total"}}</label>
        </div>
        <!-- ######## Base Stats ######## -->
        <!-- Strength-->
        <div class="character-basestats-row">
          <label class="rollable" data-roll="1d100" data-key="str" title="{{localize "PnS2.STR_MouseOver"}}">{{localize "PnS2.STR"}}</label>
          <input type="number" name="system.str.value" value="{{system.str.value}}" />
          <input type="number" name="system.str.modifier" value="{{system.str.modifier}}" />
          <label>{{system.str.total}}</label>
          <span class="calc-span">{{system.str.value}} + {{system.str.modifier}} = {{system.str.total}}</span>
        </div>
        <!-- Agility -->
        <div class="character-basestats-row">
          <label class="rollable" data-roll="1d100" data-key="agi" title="{{localize "PnS2.AGI_MouseOver"}}">{{localize "PnS2.AGI"}}</label>
          <input type="number" name="system.agi.value" value="{{system.agi.value}}" />
          <input type="number" name="system.agi.modifier" value="{{system.agi.modifier}}" />
          <label>{{system.agi.total}}</label>
          <span class="calc-span">{{system.agi.value}} + {{system.agi.modifier}} = {{system.agi.total}}</span>
        </div>
        <!-- Precision -->
        <div class="character-basestats-row">
          <label class="rollable" data-roll="1d100" data-key="pre" title="{{localize "PnS2.PRE_MouseOver"}}">{{localize "PnS2.PRE"}}</label>
          <input type="number" name="system.pre.value" value="{{system.pre.value}}" />
          <input type="number" name="system.pre.modifier" value="{{system.pre.modifier}}" />
          <label>{{system.pre.total}}</label>
          <span class="calc-span">{{system.pre.value}} + {{system.pre.modifier}} = {{system.pre.total}}</span>
        </div>
        <!-- Constitution -->
        <div class="character-basestats-row">
          <label class="rollable" data-roll="1d100" data-key="con" title="{{localize "PnS2.CON_MouseOver"}}">{{localize "PnS2.CON"}}</label>
          <input type="number" name="system.con.value" value="{{system.con.value}}" />
          <input type="number" name="system.con.modifier" value="{{system.con.modifier}}" />
          <label>{{system.con.total}}</label>
          <span class="calc-span">{{system.con.value}} + {{system.con.modifier}} = {{system.con.total}}</span>
        </div>
        <!-- Intelligence -->
        <div class="character-basestats-row">
          <label class="rollable" data-roll="1d100" data-key="int" title="{{localize "PnS2.INT_MouseOver"}}">{{localize "PnS2.INT"}}</label>
          <input type="number" name="system.int.value" value="{{system.int.value}}" />
          <input type="number" name="system.int.modifier" value="{{system.int.modifier}}" />
          <label>{{system.int.total}}</label>
          <span class="calc-span">{{system.int.value}} + {{system.int.modifier}} = {{system.int.total}}</span>
        </div>
        <!-- Charisma -->
        <div class="character-basestats-row">
          <label class="rollable" data-roll="1d100" data-key="cha" title="{{localize "PnS2.CHA_MouseOver"}}">{{localize "PnS2.CHA"}}</label>
          <input type="number" name="system.cha.value" value="{{system.cha.value}}" />
          <input type="number" name="system.cha.modifier" value="{{system.cha.modifier}}" />
          <label>{{system.cha.total}}</label>
          <span class="calc-span">{{system.cha.value}} + {{system.cha.modifier}} = {{system.cha.total}}</span>
        </div>
        <!-- Will -->
        <div class="character-basestats-row">
          <label class="rollable" data-roll="1d100" data-key="wil" title="{{localize "PnS2.WIL_MouseOver"}}">{{localize "PnS2.WIL"}}</label>
          <input type="number" name="system.wil.value" value="{{system.wil.value}}" />
          <input type="number" name="system.wil.modifier" value="{{system.wil.modifier}}" />
          <label>{{system.wil.total}}</label>
          <span class="calc-span">{{system.wil.value}} + {{system.wil.modifier}} = {{system.wil.total}}</span>
        </div>
        <br/>
        <!-- ######## Sensory stats ######## -->
        <!-- See -->
        <div class="character-basestats-row">
          <div></div>
          <label>{{localize "PnS2.CharacterSheet.Base"}}</label>
          <label>{{localize "PnS2.CharacterSheet.Modifier"}}</label>
          <label>{{localize "PnS2.CharacterSheet.Total"}}</label>
        </div>
        <!-- See -->
        <div class="character-basestats-row">
          <label class="rollable" data-roll="1d100" data-key="see" title="{{localize "PnS2.SEE_MouseOver"}}">{{localize "PnS2.SEE"}}</label>
          <input type="number" name="system.see.value" value="{{system.see.value}}" />
          <input type="number" name="system.see.modifier" value="{{system.see.modifier}}" />
          <label>{{system.see.total}}</label>
          <span class="calc-span">{{system.see.value}} + {{system.see.modifier}} = {{system.see.total}}</span>
        </div>
        <!-- Hear -->
        <div class="character-basestats-row">
          <label class="rollable" data-roll="1d100" data-key="hear" title="{{localize "PnS2.HEAR_MouseOver"}}">{{localize "PnS2.HEAR"}}</label>
          <input type="number" name="system.hear.value" value="{{system.hear.value}}" />
          <input type="number" name="system.hear.modifier" value="{{system.hear.modifier}}" />
          <label>{{system.hear.total}}</label>
          <span class="calc-span">{{system.hear.value}} + {{system.hear.modifier}} = {{system.hear.total}}</span>
        </div>
        <!-- Smell -->
        <div class="character-basestats-row">
          <label class="rollable" data-roll="1d100" data-key="smell" title="{{localize "PnS2.SMELL_MouseOver"}}">{{localize "PnS2.SMELL"}}</label>
          <input type="number" name="system.smell.value" value="{{system.smell.value}}" />
          <input type="number" name="system.smell.modifier" value="{{system.smell.modifier}}" />
          <label>{{system.smell.total}}</label>
          <span class="calc-span">{{system.smell.value}} + {{system.smell.modifier}} = {{system.smell.total}}</span>
        </div>
        <br/>
        <!-- ######## Headline ######## -->
        <div class="character-basestats-row">
          <div></div>
          <label>{{localize "PnS2.CharacterSheet.Base"}}</label>
          <label>{{localize "PnS2.CharacterSheet.Modifier"}}</label>
          <label>{{localize "PnS2.CharacterSheet.Total"}}</label>
        </div>
        <!-- Health / Health Points -->
        <div class="character-basestats-row">
          <label title="{{localize "PnS2.HP_MouseOver"}}">{{localize "PnS2.HP"}}</label>
          <input type="number" name="system.hp.value" value="{{system.hp.value}}" />
          <input type="number" name="system.hp.modifier" value="{{system.hp.modifier}}" />
          <label>{{system.hp.total}}</label>
          <span class="calc-span">{{system.hp.value}} + {{system.hp.modifier}} = {{system.hp.total}}</span>
        </div>
        <!-- Endurance / Endurance Points -->
        <div class="character-basestats-row">
          <label title="{{localize "PnS2.EP_MouseOver"}}" class="label-with-button">
            {{#if _calcVisible}}
            <button type="button" class="toggle-bar-visibility" data-action="toggle-bar" data-bar="ep">
              <i class="fas {{#if system.settings.showEpBar}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
            </button>
            {{/if}}
            {{localize "PnS2.EP"}}
          </label>
          <input type="number" name="system.ep.value" value="{{system.ep.value}}" />
          <input type="number" name="system.ep.modifier" value="{{system.ep.modifier}}" />
          <label>{{system.ep.total}}</label>
          <span class="calc-span">{{system.ep.value}} + {{system.ep.modifier}} = {{system.ep.total}}</span>
        </div>
        <!-- Mana / Mana Points -->
        <div class="character-basestats-row">
          <label title="{{localize "PnS2.MP_MouseOver"}}" class="label-with-button">
            {{#if _calcVisible}}
            <button type="button" class="toggle-bar-visibility" data-action="toggle-bar" data-bar="mp">
              <i class="fas {{#if system.settings.showMpBar}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
            </button>
            {{/if}}
            {{localize "PnS2.MP"}}
          </label>
          <input type="number" name="system.mp.value" value="{{system.mp.value}}" />
          <input type="number" name="system.mp.modifier" value="{{system.mp.modifier}}" />
          <label>{{system.mp.total}}</label>
          <span class="calc-span">{{system.mp.value}} + {{system.mp.modifier}} = {{system.mp.total}}</span>
        </div>
        <!-- Karma / Karma Points -->
        <div class="character-basestats-row">
          <label title="{{localize "PnS2.KP_MouseOver"}}" class="label-with-button">
            {{#if _calcVisible}}
            <button type="button" class="toggle-bar-visibility" data-action="toggle-bar" data-bar="kp">
              <i class="fas {{#if system.settings.showKpBar}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
            </button>
            {{/if}}
            {{localize "PnS2.KP"}}
          </label>
          <input type="number" name="system.kp.value" value="{{system.kp.value}}" />
          <input type="number" name="system.kp.modifier" value="{{system.kp.modifier}}" />
          <label>{{system.kp.total}}</label>
          <span class="calc-span">{{system.kp.value}} + {{system.kp.modifier}} = {{system.kp.total}}</span>
        </div>
        <!-- Spirit / Spirit Points -->
        <div class="character-basestats-row">
          <label title="{{localize "PnS2.SP_MouseOver"}}" class="label-with-button">
            {{#if _calcVisible}}
            <button type="button" class="toggle-bar-visibility" data-action="toggle-bar" data-bar="sp">
              <i class="fas {{#if system.settings.showSpBar}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
            </button>
            {{/if}}
            {{localize "PnS2.SP"}}
          </label>
          <input type="number" name="system.sp.value" value="{{system.sp.value}}" />
          <input type="number" name="system.sp.modifier" value="{{system.sp.modifier}}" />
          <label>{{system.sp.total}}</label>
          <span class="calc-span">{{system.sp.value}} + {{system.sp.modifier}} = {{system.sp.total}}</span>
        </div>
        <!-- ######## Headline ######## -->
        <div class="character-basestats-row">
          <div></div>
          <label>{{localize "PnS2.CharacterSheet.Base"}}</label>
          <label>{{localize "PnS2.CharacterSheet.Modifier"}}</label>          
          <label>{{localize "PnS2.CharacterSheet.Total"}}</label>        
        </div>
        <!-- Magic Resistance -->
        <div class="character-basestats-row">
          <label title="{{localize "PnS2.RST_MouseOver"}}">{{localize "PnS2.RST"}}</label>
          <input type="number" name="system.rst.value" value="{{system.rst.value}}" />
          <input type="number" name="system.rst.modifier" value="{{system.rst.modifier}}" />
          <label>{{system.rst.total}}</label>
          <span class="calc-span">{{system.rst.value}} + {{system.rst.modifier}} = {{system.rst.total}}</span>
        </div>
        <!-- Mental Resistance -->
        <div class="character-basestats-row">
          <label title="{{localize "PnS2.RES_MouseOver"}}">{{localize "PnS2.RES"}}</label>
          <input type="number" name="system.res.value" value="{{system.res.value}}" />
          <input type="number" name="system.res.modifier" value="{{system.res.modifier}}" />
          <label>{{system.res.total}}</label>
          <span class="calc-span">{{system.res.value}} + {{system.res.modifier}} = {{system.res.total}}</span>
        </div>
        <!-- Physical Resistance -->
        <div class="character-basestats-row">
          <label title="{{localize "PnS2.TOU_MouseOver"}}">{{localize "PnS2.TOU"}}</label>
          <input type="number" name="system.tou.value" value="{{system.tou.value}}" />
          <input type="number" name="system.tou.modifier" value="{{system.tou.modifier}}" />
          <label>{{system.tou.total}}</label>
          <span class="calc-span">{{system.tou.value}} + {{system.tou.modifier}} = {{system.tou.total}}</span>
        </div>
        <!-- Speed -->
        <div class="character-basestats-row">
          <label title="{{localize "PnS2.SPE_MouseOver"}}">{{localize "PnS2.SPE"}}</label>
          <input type="number" name="system.speed.value" value="{{system.speed.value}}" />
          <input type="number" name="system.speed.modifier" value="{{system.speed.modifier}}" />
          <label>{{system.speed.total}}</label>
          <span class="calc-span">{{system.speed.value}} + {{system.speed.modifier}} = {{system.speed.total}}</span>
        </div>
      </div>
    </div>
    <div class="tab" data-group="primary" data-tab="talents">
      <div class="talents-header">
        <div class="talent-name">{{localize "PNS.Talent.Name"}}</div>
        <div>{{localize "PnS2.Combination"}}</div>
        <div>{{localize "PNS.Talent.baseSum"}}</div>
        <div>{{localize "PNS.Talent.talentValue"}}</div>
        <div>{{localize "PNS.Talent.sum"}}</div>
        <div></div>
      </div>
      <div class="talents-list">
        {{#each system.talents as |talent id|}}
          <div class="talents-row" data-talent-id="{{id}}">
            <div class="talent-name rollable" data-roll="1d100" data-key="talent-{{id}}">{{talent.name}}</div>
            <div title="{{talent.combinationTooltip}}">{{talent.combination}}</div>
            <div class="talent-base">{{talent.baseSum}}</div>
            <input class="talent-value" type="number" name="system.talents.{{id}}.value" value="{{talent.value}}" data-dtype="Number" />
            <div class="talent-total">{{talent.total}}</div>
            <a class="talents-delete" title="{{localize 'Delete'}}"><i class="fas fa-trash"></i></a>
          </div>
        {{/each}}
      </div>
      <div class="add-talent-button">
          <a class="add-talent"><i class="fas fa-plus"></i> {{localize "PNS.Talent.Add"}}</a>
      </div>
    </div>
    <div class="tab" data-group="primary" data-tab="profil">
      <!-- Character Profile Information -->
      <div class="character-profile">
        <div>
          <div class="character-profile-row">
            <label>{{localize "PnS2.CharacterSheet.Charactername"}}</label>
            <input type="text" name="name" value="{{actor.name}}" />
            <br/>
            <label>{{localize "PnS2.CharacterSheet.Age"}}</label>
            <input type="number" name="system.character.age" value="{{system.character.age}}" />
          </div>
          <div class="character-profile-row">
            <label>{{localize "PnS2.CharacterSheet.Playername"}}</label>
            <input type="text" name="system.character.playername" value="{{system.character.playername}}" />
            <br/>
            <label>{{localize "PnS2.CharacterSheet.Appearance"}}</label>
            <input type="text" name="system.character.appearance" value="{{system.character.appearance}}" />
          </div>
          <div class="character-profile-row">
            <label>{{localize "PnS2.CharacterSheet.PlaceOfBirth"}}</label>
            <input type="text" name="system.character.placeofbirth" value="{{system.character.placeofbirth}}" />
            <br/>
            <label>{{localize "PnS2.CharacterSheet.Home"}}</label>
            <input type="text" name="system.character.home" value="{{system.character.home}}" />
          </div>
          <div class="character-profile-row">
            <label>{{localize "PnS2.CharacterSheet.Height"}}</label>
            <input type="text" name="system.character.height" value="{{system.character.height}}" />
            <br/>
            <label>{{localize "PnS2.CharacterSheet.Weight"}}</label>
            <input type="text" name="system.character.weight" value="{{system.character.weight}}" />
          </div>
        </div>
      </div>
    </div>
  </div>
</form>
